            <column caption='Journey Share of Sessions' datatype='real' default-format='p0.0%' name='[Calculation_221106]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([base_sessions_display]) = 0 THEN NULL ELSE SUM([stage_sessions_display]) / SUM([base_sessions_display]) END' />
