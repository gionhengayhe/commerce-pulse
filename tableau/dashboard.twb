    <worksheet name='Most Repeat Purchases Occur After One Year'>
      <table>
        <view>
          <datasources>
            <datasource caption='DS Customer' name='federated.1nhaksj10ll3n211qlf9f1dqy2a7' />
          </datasources>
          <datasource-dependencies datasource='federated.1nhaksj10ll3n211qlf9f1dqy2a7'>
            <column caption='Filter - Purchasing Customers' datatype='boolean' name='[Calculation_230001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([first_order_at])' />
            </column>
            <column caption='Second Order Timing' datatype='string' name='[Calculation_231401]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [days_to_second_order] &lt;= 90 THEN &quot;1 | ≤ 90 days&quot; ELSEIF [days_to_second_order] &lt;= 180 THEN &quot;2 | 91–180 days&quot; ELSEIF [days_to_second_order] &lt;= 365 THEN &quot;3 | 181–365 days&quot; ELSEIF [days_to_second_order] &lt;= 730 THEN &quot;4 | 1–2 years&quot; ELSE &quot;5 | 2+ years&quot; END' />
              <aliases>
                <alias key='&quot;1 | ≤ 90 days&quot;' value='≤ 90 days' />
                <alias key='&quot;2 | 91–180 days&quot;' value='91–180 days' />
                <alias key='&quot;3 | 181–365 days&quot;' value='181–365 days' />
                <alias key='&quot;4 | 1–2 years&quot;' value='1–2 years' />
                <alias key='&quot;5 | 2+ years&quot;' value='2+ years' />
              </aliases>
            </column>
            <column caption='Share of Repeat Customers' datatype='real' default-format='p0.0%' name='[Calculation_231402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_id]) / TOTAL(COUNTD([customer_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Customer Country' datatype='string' name='[customer_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Id' datatype='integer' name='[customer_id]' role='dimension' type='ordinal' />
            <column caption='Days To Second Order' datatype='integer' name='[days_to_second_order]' role='measure' type='quantitative' />
            <column caption='First Order At' datatype='datetime' name='[first_order_at]' role='dimension' type='ordinal' />
            <column caption='First Session Source' datatype='string' name='[first_session_source]' role='dimension' type='nominal' />
            <column caption='Is Repeat Customer' datatype='boolean' name='[is_repeat_customer]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_230001]' derivation='None' name='[none:Calculation_230001:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_231401]' derivation='None' name='[none:Calculation_231401:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_country]' derivation='None' name='[none:customer_country:nk]' pivot='key' type='nominal' />
            <column-instance column='[first_session_source]' derivation='None' name='[none:first_session_source:nk]' pivot='key' type='nominal' />
            <column-instance column='[is_repeat_customer]' derivation='None' name='[none:is_repeat_customer:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_231402]' derivation='User' name='[usr:Calculation_231402:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
            </column-instance>
            <column-instance column='[first_order_at]' derivation='Year' name='[yr:first_order_at:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[none:Calculation_230001:nk]'>
            <groupfilter function='member' level='[none:Calculation_230001:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <manual-sort column='[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[none:Calculation_231401:nk]' direction='ASC'>
