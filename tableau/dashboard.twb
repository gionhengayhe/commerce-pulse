      </column>
      <column caption='Checkout Completion - Dec' datatype='string' name='[Calculation_220146]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_220126] &lt; 0 THEN &quot;▼&quot; END' />
      </column>
      <column caption='KPI 1 Axis' datatype='integer' name='[Calculation_220201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 2 Axis' datatype='integer' name='[Calculation_220202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 3 Axis' datatype='integer' name='[Calculation_220203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 4 Axis' datatype='integer' name='[Calculation_220204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 5 Axis' datatype='integer' name='[Calculation_220205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 6 Axis' datatype='integer' hidden='true' name='[Calculation_220206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='1. Sessions' datatype='integer' default-format='n#,##0' name='[Calculation_221101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sessions])' />
      </column>
      <column caption='2. Product Views' datatype='integer' default-format='n#,##0' name='[Calculation_221102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([view_sessions])' />
      </column>
      <column caption='3. Added to Cart' datatype='integer' default-format='n#,##0' name='[Calculation_221103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([cart_sessions])' />
      </column>
      <column caption='4. Checkout' datatype='integer' default-format='n#,##0' name='[Calculation_221104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([checkout_sessions])' />
      </column>
      <column caption='5. Purchase' datatype='integer' default-format='n#,##0' name='[Calculation_221105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchase_sessions])' />
      </column>
      <column caption='Journey Share of Sessions' datatype='real' default-format='p0.0%' name='[Calculation_221106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([base_sessions_display]) = 0 THEN NULL ELSE SUM([stage_sessions_display]) / SUM([base_sessions_display]) END' />
      </column>
      <column caption='Donut Axis' datatype='integer' name='[Calculation_221107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Journey Achieved Slice' datatype='boolean' name='[Calculation_221109]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[slice] = &quot;Achieved&quot;' />
      </column>
      <column caption='Journey Achieved Value' datatype='integer' default-format='n#,##0' name='[Calculation_221110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [slice] = &quot;Achieved&quot; THEN [slice_value] END)' />
      </column>
      <column caption='Journey Remaining Value' datatype='integer' default-format='n#,##0' name='[Calculation_221111]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [slice] = &quot;Remaining&quot; THEN [slice_value] END)' />
      </column>
      <column caption='Donut Hole' datatype='string' name='[Calculation_221112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Hole&quot;' />
      </column>
      <column caption='Journey Hole Value' datatype='integer' default-format='n#,##0' name='[Calculation_221113]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0)' />
      </column>
      <column caption='Journey Path Stage' datatype='integer' default-format='n0' name='[Calculation_221119]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[stage_order]' />
      </column>
      <column caption='Journey Path Lower' datatype='integer' default-format='n#,##0' name='[Calculation_221120]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([stage_sessions_display])' />
      </column>
      <column caption='Conversion Rate' datatype='real' default-format='p0.0%' name='[Calculation_221301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sessions]) = 0 THEN NULL ELSE SUM([purchase_sessions]) / SUM([sessions]) END' />
      </column>
      <column caption='Conversion Rate' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_221401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sessions]) = 0 THEN NULL ELSE SUM([purchase_sessions]) / SUM([sessions]) END' />
      </column>
      <column caption='Average Order Value' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' hidden='true' name='[Calculation_221402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([orders]) = 0 THEN NULL ELSE SUM([net_sales_usd]) / SUM([orders]) END' />
      </column>
      <column caption='Cart-to-Checkout Rate' datatype='real' default-format='p0.0%' name='[Calculation_221501]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([cart_sessions]) = 0 THEN NULL ELSE SUM([checkout_sessions]) / SUM([cart_sessions]) END' />
      </column>
      <column caption='Lowest Monthly Cart-to-Checkout Rate' datatype='real' default-format='p0.0%' name='[Calculation_242002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MIN([Calculation_221501])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Highest Monthly Cart-to-Checkout Rate' datatype='real' default-format='p0.0%' name='[Calculation_242003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_221501])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Monthly Rate Range' datatype='real' default-format='n0.0' name='[Calculation_242004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Monthly Rate Range&#13;&#10;[Calculation_242003] - [Calculation_242002]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Annual Cart-to-Checkout Rate' datatype='real' default-format='p0.0%' name='[Cart-to-Checkout Rate (copy)_0318071376384004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM([checkout_sessions])&#13;&#10;}&#13;&#10;/&#13;&#10;{ FIXED :&#13;&#10;    SUM([cart_sessions])&#13;&#10;}' />
      </column>
      <column caption='Monthly Checkout Sessions' datatype='integer' name='[Monthly Cart Sessions (copy)_0318071375572994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_0318071374913536] :&#13;&#10;    SUM([checkout_sessions])&#13;&#10;}' />
      </column>
      <column caption='Monthly Cart-to-Checkout Rate' datatype='real' default-format='n0.0' name='[Monthly Cart-to-Checkout Range (copy)_0318071376187395]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Monthly Cart Sessions (copy)_0318071375572994]&#13;&#10;/&#13;&#10;[Calculation_0318071375499265]' />
      </column>
