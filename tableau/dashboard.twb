    <worksheet name='Repeat Customers Drive Business Value'>
      <table>
        <view>
          <datasources>
            <datasource caption='DS Customer' name='federated.1nhaksj10ll3n211qlf9f1dqy2a7' />
          </datasources>
          <datasource-dependencies datasource='federated.1nhaksj10ll3n211qlf9f1dqy2a7'>
            <column caption='Filter - Purchasing Customers' datatype='boolean' name='[Calculation_230001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([first_order_at])' />
            </column>
            <column caption='Customer Type' datatype='string' name='[Calculation_231301]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [is_repeat_customer] THEN &quot;Repeat Customers&quot; ELSE &quot;One-Time Customers&quot; END' />
            </column>
            <column caption='Customer Share' datatype='real' default-format='p0.0%' name='[Calculation_231302]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_id]) / TOTAL(COUNTD([customer_id]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Sales Share' datatype='real' default-format='p0.0%' name='[Calculation_231303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([net_sales_usd]) / TOTAL(SUM([net_sales_usd]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Profit Share' datatype='real' default-format='p0.0%' name='[Calculation_231304]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([estimated_gross_profit_usd]) / TOTAL(SUM([estimated_gross_profit_usd]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Customer Country' datatype='string' name='[customer_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
