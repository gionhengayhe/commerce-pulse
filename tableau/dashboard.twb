            <column caption='Monthly Cart-to-Checkout Rate' datatype='real' default-format='n0.0' name='[Monthly Cart-to-Checkout Range (copy)_0318071376187395]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Monthly Cart Sessions (copy)_0318071375572994]&#13;&#10;/&#13;&#10;[Calculation_0318071375499265]' />
