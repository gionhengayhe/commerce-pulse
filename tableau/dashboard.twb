    <worksheet name='Repeat Purchase by Time Window'>
      <table>
        <view>
          <datasources>
            <datasource caption='DS Customer' name='federated.1nhaksj10ll3n211qlf9f1dqy2a7' />
          </datasources>
          <datasource-dependencies datasource='federated.1nhaksj10ll3n211qlf9f1dqy2a7'>
            <column caption='Filter - Purchasing Customers' datatype='boolean' name='[Calculation_230001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([first_order_at])' />
            </column>
            <column caption='Observed Repeat' datatype='real' default-format='p0.0%' name='[Calculation_231101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([customer_id]) = 0 THEN NULL ELSE COUNTD(IF [is_repeat_customer] THEN [customer_id] END) / COUNTD([customer_id]) END' />
            </column>
            <column caption='Repeat within 30 Days' datatype='real' default-format='p0.0%' name='[Calculation_231102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_30d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_30d] AND [repeat_30d] THEN [customer_id] END) / COUNTD(IF [is_eligible_30d] THEN [customer_id] END) END' />
            </column>
            <column caption='Repeat within 60 Days' datatype='real' default-format='p0.0%' name='[Calculation_231103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_60d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_60d] AND [repeat_60d] THEN [customer_id] END) / COUNTD(IF [is_eligible_60d] THEN [customer_id] END) END' />
            </column>
            <column caption='Repeat within 90 Days' datatype='real' default-format='p0.0%' name='[Calculation_231104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_90d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_90d] AND [repeat_90d] THEN [customer_id] END) / COUNTD(IF [is_eligible_90d] THEN [customer_id] END) END' />
            </column>
            <column caption='Customer Country' datatype='string' name='[customer_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Id' datatype='integer' name='[customer_id]' role='dimension' type='ordinal' />
            <column caption='First Order At' datatype='datetime' name='[first_order_at]' role='dimension' type='ordinal' />
            <column caption='First Session Source' datatype='string' name='[first_session_source]' role='dimension' type='nominal' />
            <column caption='Is Eligible 30D' datatype='boolean' name='[is_eligible_30d]' role='dimension' type='nominal' />
            <column caption='Is Eligible 60D' datatype='boolean' name='[is_eligible_60d]' role='dimension' type='nominal' />
            <column caption='Is Eligible 90D' datatype='boolean' name='[is_eligible_90d]' role='dimension' type='nominal' />
            <column caption='Is Repeat Customer' datatype='boolean' name='[is_repeat_customer]' role='dimension' type='nominal' />
