    <worksheet name='Observed Repeat Falls for Newer Cohorts; 90-Day Repeat Is Stable'>
      <table>
        <view>
          <datasources>
            <datasource caption='DS Customer' name='federated.1nhaksj10ll3n211qlf9f1dqy2a7' />
          </datasources>
          <datasource-dependencies datasource='federated.1nhaksj10ll3n211qlf9f1dqy2a7'>
            <column caption='Filter - Purchasing Customers' datatype='boolean' name='[Calculation_230001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([first_order_at])' />
            </column>
            <column caption='Observed Repeat Rate by Cohort' datatype='real' default-format='p0.0%' name='[Calculation_231201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([customer_id]) = 0 THEN NULL ELSE COUNTD(IF [is_repeat_customer] THEN [customer_id] END) / COUNTD([customer_id]) END' />
            </column>
            <column caption='90-Day Repeat Rate by Cohort' datatype='real' default-format='p0.0%' name='[Calculation_231202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_90d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_90d] AND [repeat_90d] THEN [customer_id] END) / COUNTD(IF [is_eligible_90d] THEN [customer_id] END) END' />
            </column>
            <column caption='Customer Country' datatype='string' name='[customer_country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Id' datatype='integer' name='[customer_id]' role='dimension' type='ordinal' />
            <column caption='First Order At' datatype='datetime' name='[first_order_at]' role='dimension' type='ordinal' />
            <column caption='First Session Source' datatype='string' name='[first_session_source]' role='dimension' type='nominal' />
            <column caption='Is Eligible 90D' datatype='boolean' name='[is_eligible_90d]' role='dimension' type='nominal' />
            <column caption='Is Repeat Customer' datatype='boolean' name='[is_repeat_customer]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_230001]' derivation='None' name='[none:Calculation_230001:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_country]' derivation='None' name='[none:customer_country:nk]' pivot='key' type='nominal' />
            <column-instance column='[first_session_source]' derivation='None' name='[none:first_session_source:nk]' pivot='key' type='nominal' />
            <column caption='Repeat 90D' datatype='boolean' name='[repeat_90d]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_231201]' derivation='User' name='[usr:Calculation_231201:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_231202]' derivation='User' name='[usr:Calculation_231202:qk]' pivot='key' type='quantitative' />
            <column-instance column='[first_order_at]' derivation='Year' name='[yr:first_order_at:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[usr:Calculation_231201:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[usr:Calculation_231202:qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[none:Calculation_230001:nk]'>
            <groupfilter function='member' level='[none:Calculation_230001:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <natural-sort column='[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[yr:first_order_at:ok]' direction='ASC' />
          <slices>
            <column>[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[none:Calculation_230001:nk]</column>
            <column>[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[:Measure Names]</column>
            <column>[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[none:first_session_source:nk]</column>
            <column>[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[none:customer_country:nk]</column>
            <column>[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[yr:first_order_at:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.1nhaksj10ll3n211qlf9f1dqy2a7].[Multiple Values]' scope='cols' value='Repeat rate' />
