            <column caption='Filter - Purchasing Customers' datatype='boolean' name='[Calculation_230001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([first_order_at])' />
            </column>
            <column caption='Purchasing Customers' datatype='integer' default-format='n#,##0' name='[Calculation_230101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([customer_id])' />
            </column>
            <column caption='Repeat Customers' datatype='integer' default-format='n#,##0' name='[Calculation_230102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_repeat_customer] THEN [customer_id] END)' />
            </column>
            <column caption='Repeat Customer Rate' datatype='real' default-format='p0.0%' name='[Calculation_230103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([customer_id]) = 0 THEN NULL ELSE COUNTD(IF [is_repeat_customer] THEN [customer_id] END) / COUNTD([customer_id]) END' />
            </column>
            <column caption='90-Day Repeat Rate' datatype='real' default-format='p0.0%' name='[Calculation_230104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_90d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_90d] AND [repeat_90d] THEN [customer_id] END) / COUNTD(IF [is_eligible_90d] THEN [customer_id] END) END' />
            </column>
            <column caption='Median Days to 2nd Order' datatype='real' default-format='n#,##0' name='[Calculation_230105]' role='measure' type='quantitative'>
