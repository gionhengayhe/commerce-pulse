            <column caption='p_Analysis Year' datatype='integer' datatype-customized='true' default-format='n0;-0' name='[Parameter 0808176514207744]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ncwajr1cstery1fny6b605ttnuq'>
            <column caption='AVG(1)' datatype='real' name='[Calculation_0895863627190275]' role='measure' type='quantitative' user:unnamed='Conversion Rate by Source'>
              <calculation class='tableau' formula='AVG(1)' />
            </column>
            <column caption='Filter - Analysis Year' datatype='boolean' name='[Calculation_220001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([date_day]) = [Parameters].[Parameter 0808176514207744]' />
            </column>
            <column caption='Conversion Rate' datatype='real' default-format='p0.0%' name='[Calculation_221301]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([sessions]) = 0 THEN NULL ELSE SUM([purchase_sessions]) / SUM([sessions]) END' />
            </column>
