      <column caption='General Time Identify' datatype='integer' default-format='n0;-0' name='[Calculation_0412627662340116]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([date_day])' />
      </column>
      <column caption='Time - Select?' datatype='boolean' name='[Calculation_0412627666169877]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0412627662340116] = [Parameters].[Parameter 0808176514207744]' />
      </column>
      <column caption='Filter - Analysis Year' datatype='boolean' name='[Calculation_0808176528752644]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] AND [date_day] &lt;= [Calculation_202608200001]' />
      </column>
      <column caption='Session Conversion Rate' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_0808176533770247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sessions]) = 0 THEN NULL&#13;&#10;ELSE&#13;&#10;    SUM([purchase_sessions]) / SUM([sessions])&#13;&#10;END' />
      </column>
      <column caption='Estimated Gross Margin %' datatype='real' default-format='p0.0%' hidden='true' name='[Calculation_0808176534003720]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([net_sales_usd]) = 0 THEN NULL&#13;&#10;ELSE&#13;&#10;    SUM([estimated_gross_profit_usd])&#13;&#10;    /&#13;&#10;    SUM([net_sales_usd])&#13;&#10;END' />
      </column>
      <column caption='Estimated GP / Session' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' hidden='true' name='[Calculation_0808176534282249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sessions]) = 0 THEN NULL&#13;&#10;ELSE&#13;&#10;    SUM([estimated_gross_profit_usd])&#13;&#10;    /&#13;&#10;    SUM([sessions])&#13;&#10;END' />
      </column>
      <column caption='Discounts' datatype='real' name='[Calculation_1074259014565897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='- [discount_amount_usd]' />
      </column>
      <column caption='Product Cost' datatype='real' name='[Calculation_1074259014721546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-[estimated_cogs_usd]' />
      </column>
      <column caption='Total Sales YoY' datatype='real' default-format='p0.00%' name='[Calculation_1414557538336768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Net Sales current year (copy)_1414557547892745] = 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    ([Calculation_1414557547778056] - [Net Sales current year (copy)_1414557547892745])&#13;&#10;    /&#13;&#10;    [Net Sales current year (copy)_1414557547892745]&#13;&#10;END' />
      </column>
      <column caption='Filter - Current and Prior Year' datatype='boolean' name='[Calculation_1414557545345030]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([date_day]) = [Parameters].[Parameter 0808176514207744]&#13;&#10;OR&#13;&#10;YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1' />
      </column>
      <column caption='Total Sales current year' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_1414557547778056]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744]&#13;&#10;    THEN [net_sales_usd]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Total Sales Inc' datatype='string' name='[Calculation_1414557550391306]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1414557538336768] &gt; 0 THEN &quot;▲&quot; END' />
      </column>
      <column caption='Estimated GP current year' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_192001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [estimated_gross_profit_usd] END)' />
      </column>
      <column caption='Estimated GP prior year' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_192002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_202608200001]) THEN [estimated_gross_profit_usd] END)' />
      </column>
      <column caption='Estimated GP YoY' datatype='real' default-format='p0.00%' name='[Calculation_192003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_192002] = 0 THEN NULL ELSE ([Calculation_192001] - [Calculation_192002]) / [Calculation_192002] END' />
      </column>
      <column caption='Estimated GP Inc' datatype='string' name='[Calculation_192004]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_192003] &gt; 0 THEN &quot;▲&quot; END' />
      </column>
      <column caption='Estimated GP Dec' datatype='string' name='[Calculation_192005]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_192003] &lt; 0 THEN &quot;▼&quot; END' />
      </column>
      <column caption='Gross Margin current year' datatype='real' default-format='p0.00%' name='[Calculation_192101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [net_sales_usd] END) = 0 THEN NULL ELSE SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [estimated_gross_profit_usd] END) / SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [net_sales_usd] END) END' />
      </column>
      <column caption='Gross Margin prior year' datatype='real' default-format='p0.00%' name='[Calculation_192102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_202608200001]) THEN [net_sales_usd] END) = 0 THEN NULL ELSE SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_202608200001]) THEN [estimated_gross_profit_usd] END) / SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_202608200001]) THEN [net_sales_usd] END) END' />
      </column>
      <column caption='Profit Margin change (pp)' datatype='real' default-format='+0.00 &quot;pp&quot;;-0.00 &quot;pp&quot;;0.00 &quot;pp&quot;' name='[Calculation_192103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_192101] - [Calculation_192102]) * 100' />
      </column>
      <column caption='Gross Margin Inc' datatype='string' name='[Calculation_192104]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_192103] &gt; 0 THEN &quot;▲&quot; END' />
      </column>
      <column caption='Gross Margin Dec' datatype='string' name='[Calculation_192105]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_192103] &lt; 0 THEN &quot;▼&quot; END' />
      </column>
      <column caption='Orders current year' datatype='integer' default-format='n#,##0' name='[Calculation_192201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [orders] END)' />
      </column>
      <column caption='Orders prior year' datatype='integer' default-format='n#,##0' name='[Calculation_192202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_202608200001]) THEN [orders] END)' />
      </column>
      <column caption='Orders YoY' datatype='real' default-format='p0.00%' name='[Calculation_192203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_192202] = 0 THEN NULL ELSE ([Calculation_192201] - [Calculation_192202]) / [Calculation_192202] END' />
