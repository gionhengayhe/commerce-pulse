      <column caption='Icon axis' datatype='integer' name='[Calculation_0095145084674050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Profit Contribution Gap' datatype='real' name='[Calculation_0529177558798340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0808176536207373] - [Calculation_0808176535867404]' />
      </column>
      <column caption='Profit vs Attention Gap - Label' datatype='string' name='[Calculation_0529177560674312]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Profit vs Attention Gap - Label&#13;&#10;&#13;&#10;IF [Calculation_0529177558798340] &gt; 0 THEN&#13;&#10;    &quot;+&quot; + STR(ROUND([Calculation_0529177558798340] * 100, 1)) + &quot; pp&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_0529177558798340] &lt; 0 THEN&#13;&#10;    STR(ROUND([Calculation_0529177558798340] * 100, 1)) + &quot; pp&quot;&#13;&#10;&#13;&#10;ELSE&#13;&#10;    &quot;0.0 pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Filter - Analysis Year' datatype='boolean' name='[Calculation_0808176531431430]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='YEAR([calendar_month]) = [Parameters].[Parameter 0808176514207744]' />
      </column>
      <column caption='View-to-Purchase Conversion' datatype='real' default-format='p0.0%' name='[Calculation_0808176535457802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([view_sessions]) = 0 THEN NULL&#13;&#10;ELSE&#13;&#10;    SUM([viewed_purchase_sessions])&#13;&#10;    /&#13;&#10;    SUM([view_sessions])&#13;&#10;END' />
      </column>
      <column caption='Profit per Product View' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_0808176535789579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([view_sessions]) = 0 THEN NULL&#13;&#10;ELSE&#13;&#10;    SUM([estimated_gross_profit_usd])&#13;&#10;    /&#13;&#10;    SUM([view_sessions])&#13;&#10;END' />
      </column>
      <column caption='Product View Share' datatype='real' default-format='p0.0%' name='[Calculation_0808176535867404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([view_sessions])&#13;&#10;/&#13;&#10;MIN(&#13;&#10;    { FIXED : SUM([view_sessions]) }&#13;&#10;)' />
      </column>
      <column caption='Profit Share' datatype='real' default-format='p0.0%' name='[Calculation_0808176536207373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_gross_profit_usd])&#13;&#10;/&#13;&#10;MIN(&#13;&#10;    { FIXED : SUM([estimated_gross_profit_usd]) }&#13;&#10;)' />
      </column>
      <column caption='Actual' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_191001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([calendar_month]) = [Parameters].[Parameter 0808176514207744] THEN [net_sales_usd] END) }' />
      </column>
      <column caption='Last Year' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_191002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([calendar_month]) = [Parameters].[Parameter 0808176514207744] - 1 THEN [net_sales_usd] END) }' />
      </column>
      <column caption='Variance' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_191003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_191001] - [Calculation_191002]' />
      </column>
      <column caption='YoY %' datatype='real' default-format='p0.0%' name='[Calculation_191004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_191002] = 0 THEN NULL ELSE [Calculation_191003] / [Calculation_191002] END' />
      </column>
      <column caption='Product Cost' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_191005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[net_sales_usd] - [estimated_gross_profit_usd]' />
      </column>
      <column caption='Conversion Rate' datatype='real' default-format='p0.0%' name='[Calculation_221201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([view_sessions]) = 0 THEN NULL ELSE SUM([viewed_purchase_sessions]) / SUM([view_sessions]) END' />
      </column>
