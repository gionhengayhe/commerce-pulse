      <column caption='Customers current year' datatype='integer' default-format='n#,##0' name='[Calculation_192301]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [purchasing_customers_ytd] END)' />
      </column>
      <column caption='Customers prior year' datatype='integer' default-format='n#,##0' name='[Calculation_192302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(IF [date_day] = DATEADD(&quot;year&quot;, -1, [Calculation_202608200001]) THEN [purchasing_customers_ytd] END)' />
