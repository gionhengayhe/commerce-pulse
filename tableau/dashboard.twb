      <column caption='Customers YoY' datatype='real' default-format='p0.00%' name='[Calculation_192303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_192302] = 0 THEN NULL ELSE ([Calculation_192301] - [Calculation_192302]) / [Calculation_192302] END' />
