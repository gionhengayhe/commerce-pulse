            <run bold='false' fontsize='9'><![CDATA[       <[federated.0ncwajr1cstery1fny6b605ttnuq].[sum:Cart-to-Checkout Rate (copy)_0318071376384004:qk]>                          <[federated.0ncwajr1cstery1fny6b605ttnuq].[usr:Calculation_242002:qk:4]>                           <[federated.0ncwajr1cstery1fny6b605ttnuq].[usr:Calculation_242003:qk:4]>]]></run>
