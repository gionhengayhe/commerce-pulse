    <worksheet name='Page 2 KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='DS Funnel' name='federated.0ncwajr1cstery1fny6b605ttnuq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Analysis Year' datatype='integer' datatype-customized='true' default-format='n0;-0' name='[Parameter 0808176514207744]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ncwajr1cstery1fny6b605ttnuq'>
            <column caption='Filter - Current and Prior Year' datatype='boolean' name='[Calculation_220002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] OR YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1' />
            </column>
            <column caption='Latest Active Date - Selected Year' datatype='date' name='[Calculation_220010]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] AND ([sessions] &gt; 0 OR [net_sales_usd] &lt;&gt; 0) THEN [date_day] END) }' />
            </column>
            <column caption='Latest Visitor Date - Selected Year' datatype='date' hidden='true' name='[Calculation_220011]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(IF YEAR([visitor_date_day]) = [Parameters].[Parameter 0808176514207744] THEN [visitor_date_day] END) }' />
            </column>
            <column caption='Total Sessions - CY' datatype='integer' default-format='n#,##0' name='[Calculation_220101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [sessions] END)' />
            </column>
            <column caption='Sessions with Orders - CY' datatype='integer' default-format='n#,##0' name='[Calculation_220102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [purchase_sessions] END)' />
            </column>
            <column caption='Unique Visitors - CY' datatype='integer' default-format='n#,##0' name='[Calculation_220103]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([visitor_date_day]) = [Parameters].[Parameter 0808176514207744] THEN [visitor_customer_id] END)' />
            </column>
            <column caption='Conversion Rate - CY' datatype='real' default-format='p0.0%' name='[Calculation_220104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [sessions] END) = 0 THEN NULL ELSE SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [purchase_sessions] END) / SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [sessions] END) END' />
            </column>
            <column caption='Avg. Order Value - CY' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_220105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [orders] END) = 0 THEN NULL ELSE SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [net_sales_usd] END) / SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] THEN [orders] END) END' />
            </column>
            <column caption='Total Sessions - PY' datatype='integer' default-format='n#,##0' name='[Calculation_220111]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220010]) THEN [sessions] END)' />
            </column>
            <column caption='Sessions with Orders - PY' datatype='integer' default-format='n#,##0' name='[Calculation_220112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220010]) THEN [purchase_sessions] END)' />
            </column>
            <column caption='Unique Visitors - PY' datatype='integer' default-format='n#,##0' name='[Calculation_220113]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF YEAR([visitor_date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [visitor_date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220011]) THEN [visitor_customer_id] END)' />
            </column>
            <column caption='Conversion Rate - PY' datatype='real' default-format='p0.0%' name='[Calculation_220114]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220010]) THEN [sessions] END) = 0 THEN NULL ELSE SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220010]) THEN [purchase_sessions] END) / SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220010]) THEN [sessions] END) END' />
            </column>
            <column caption='Avg. Order Value - PY' datatype='real' default-format='c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_220115]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220010]) THEN [orders] END) = 0 THEN NULL ELSE SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220010]) THEN [net_sales_usd] END) / SUM(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] - 1 AND [date_day] &lt;= DATEADD(&quot;year&quot;, -1, [Calculation_220010]) THEN [orders] END) END' />
            </column>
            <column caption='Total Sessions - YoY %' datatype='real' default-format='p0.0%' name='[Calculation_220121]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_220111] = 0 THEN NULL ELSE ([Calculation_220101] - [Calculation_220111]) / [Calculation_220111] END' />
            </column>
            <column caption='Sessions with Orders - YoY %' datatype='real' default-format='p0.0%' name='[Calculation_220122]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_220112] = 0 THEN NULL ELSE ([Calculation_220102] - [Calculation_220112]) / [Calculation_220112] END' />
            </column>
            <column caption='Unique Visitors - YoY %' datatype='real' default-format='p0.0%' name='[Calculation_220123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_220113] = 0 THEN NULL ELSE ([Calculation_220103] - [Calculation_220113]) / [Calculation_220113] END' />
            </column>
            <column caption='Conversion Rate change (pp)' datatype='real' default-format='+0.0 &quot;pp&quot;;-0.0 &quot;pp&quot;;0.0 &quot;pp&quot;' name='[Calculation_220124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_220104] - [Calculation_220114]) * 100' />
            </column>
            <column caption='Avg. Order Value - YoY %' datatype='real' default-format='p0.0%' name='[Calculation_220125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_220115] = 0 THEN NULL ELSE ([Calculation_220105] - [Calculation_220115]) / [Calculation_220115] END' />
            </column>
            <column caption='Total Sessions - Inc' datatype='string' name='[Calculation_220131]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220121] &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='Sessions with Orders - Inc' datatype='string' name='[Calculation_220132]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220122] &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='Unique Visitors - Inc' datatype='string' name='[Calculation_220133]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220123] &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='Conversion Rate - Inc' datatype='string' name='[Calculation_220134]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220124] &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='Avg. Order Value - Inc' datatype='string' name='[Calculation_220135]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220125] &gt; 0 THEN &quot;▲&quot; END' />
            </column>
            <column caption='Total Sessions - Dec' datatype='string' name='[Calculation_220141]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220121] &lt; 0 THEN &quot;▼&quot; END' />
            </column>
            <column caption='Sessions with Orders - Dec' datatype='string' name='[Calculation_220142]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220122] &lt; 0 THEN &quot;▼&quot; END' />
            </column>
            <column caption='Unique Visitors - Dec' datatype='string' name='[Calculation_220143]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220123] &lt; 0 THEN &quot;▼&quot; END' />
            </column>
            <column caption='Conversion Rate - Dec' datatype='string' name='[Calculation_220144]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220124] &lt; 0 THEN &quot;▼&quot; END' />
            </column>
            <column caption='Avg. Order Value - Dec' datatype='string' name='[Calculation_220145]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_220125] &lt; 0 THEN &quot;▼&quot; END' />
            </column>
            <column caption='KPI 1 Axis' datatype='integer' name='[Calculation_220201]' role='measure' type='quantitative'>
