      <aliases enabled='yes' />
      <column caption='Filter - Purchasing Customers' datatype='boolean' name='[Calculation_230001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([first_order_at])' />
      </column>
      <column caption='Purchasing Customers' datatype='integer' default-format='n#,##0' name='[Calculation_230101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id])' />
      </column>
      <column caption='Repeat Customers' datatype='integer' default-format='n#,##0' name='[Calculation_230102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_repeat_customer] THEN [customer_id] END)' />
      </column>
      <column caption='Repeat Customer Rate' datatype='real' default-format='p0.0%' name='[Calculation_230103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([customer_id]) = 0 THEN NULL ELSE COUNTD(IF [is_repeat_customer] THEN [customer_id] END) / COUNTD([customer_id]) END' />
      </column>
      <column caption='90-Day Repeat Rate' datatype='real' default-format='p0.0%' name='[Calculation_230104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_90d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_90d] AND [repeat_90d] THEN [customer_id] END) / COUNTD(IF [is_eligible_90d] THEN [customer_id] END) END' />
      </column>
      <column caption='Median Days to 2nd Order' datatype='real' default-format='n#,##0' name='[Calculation_230105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN([days_to_second_order])' />
      </column>
      <column caption='Avg. Orders per Customer' datatype='real' default-format='n0.00' name='[Calculation_230106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([customer_id]) = 0 THEN NULL ELSE SUM([order_count]) / COUNTD([customer_id]) END' />
      </column>
      <column caption='KPI 1 Axis' datatype='integer' name='[Calculation_230201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 2 Axis' datatype='integer' name='[Calculation_230202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 3 Axis' datatype='integer' name='[Calculation_230203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 4 Axis' datatype='integer' name='[Calculation_230204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 5 Axis' datatype='integer' name='[Calculation_230205]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='KPI 6 Axis' datatype='integer' name='[Calculation_230206]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Observed Repeat' datatype='real' default-format='p0.0%' name='[Calculation_231101]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([customer_id]) = 0 THEN NULL ELSE COUNTD(IF [is_repeat_customer] THEN [customer_id] END) / COUNTD([customer_id]) END' />
      </column>
      <column caption='Repeat within 30 Days' datatype='real' default-format='p0.0%' name='[Calculation_231102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_30d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_30d] AND [repeat_30d] THEN [customer_id] END) / COUNTD(IF [is_eligible_30d] THEN [customer_id] END) END' />
      </column>
      <column caption='Repeat within 60 Days' datatype='real' default-format='p0.0%' name='[Calculation_231103]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_60d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_60d] AND [repeat_60d] THEN [customer_id] END) / COUNTD(IF [is_eligible_60d] THEN [customer_id] END) END' />
      </column>
      <column caption='Repeat within 90 Days' datatype='real' default-format='p0.0%' name='[Calculation_231104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_90d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_90d] AND [repeat_90d] THEN [customer_id] END) / COUNTD(IF [is_eligible_90d] THEN [customer_id] END) END' />
      </column>
      <column caption='Observed Repeat Rate by Cohort' datatype='real' default-format='p0.0%' name='[Calculation_231201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([customer_id]) = 0 THEN NULL ELSE COUNTD(IF [is_repeat_customer] THEN [customer_id] END) / COUNTD([customer_id]) END' />
      </column>
      <column caption='90-Day Repeat Rate by Cohort' datatype='real' default-format='p0.0%' name='[Calculation_231202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD(IF [is_eligible_90d] THEN [customer_id] END) = 0 THEN NULL ELSE COUNTD(IF [is_eligible_90d] AND [repeat_90d] THEN [customer_id] END) / COUNTD(IF [is_eligible_90d] THEN [customer_id] END) END' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_231301]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_repeat_customer] THEN &quot;Repeat Customers&quot; ELSE &quot;One-Time Customers&quot; END' />
      </column>
      <column caption='Customer Share' datatype='real' default-format='p0.0%' name='[Calculation_231302]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id]) / TOTAL(COUNTD([customer_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales Share' datatype='real' default-format='p0.0%' name='[Calculation_231303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([net_sales_usd]) / TOTAL(SUM([net_sales_usd]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit Share' datatype='real' default-format='p0.0%' name='[Calculation_231304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([estimated_gross_profit_usd]) / TOTAL(SUM([estimated_gross_profit_usd]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Second Order Timing' datatype='string' name='[Calculation_231401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [days_to_second_order] &lt;= 90 THEN &quot;1 | ≤ 90 days&quot; ELSEIF [days_to_second_order] &lt;= 180 THEN &quot;2 | 91–180 days&quot; ELSEIF [days_to_second_order] &lt;= 365 THEN &quot;3 | 181–365 days&quot; ELSEIF [days_to_second_order] &lt;= 730 THEN &quot;4 | 1–2 years&quot; ELSE &quot;5 | 2+ years&quot; END' />
        <aliases>
          <alias key='&quot;1 | ≤ 90 days&quot;' value='≤ 90 days' />
          <alias key='&quot;2 | 91–180 days&quot;' value='91–180 days' />
          <alias key='&quot;3 | 181–365 days&quot;' value='181–365 days' />
          <alias key='&quot;4 | 1–2 years&quot;' value='1–2 years' />
          <alias key='&quot;5 | 2+ years&quot;' value='2+ years' />
        </aliases>
      </column>
      <column caption='Share of Repeat Customers' datatype='real' default-format='p0.0%' name='[Calculation_231402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([customer_id]) / TOTAL(COUNTD([customer_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
