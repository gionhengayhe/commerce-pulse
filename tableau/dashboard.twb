          <zone h='3500' id='496' type-v2='text' w='13000' x='1000' y='49000'>
            <formatted-text>
              <run bold='true' fontcolor='#17324d' fontname='Tableau Book' fontsize='10'>DECISION FRAME</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='2' />
            </zone-style>
          </zone>
          <zone h='10000' id='406' type-v2='empty' w='30000' x='70000' y='0'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='0' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius-top-right' value='20' />
              <format attr='margin' value='0' />
              <format attr='background-color' value='#78b5e8' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='10833' id='498' type-v2='text' w='83500' x='16000' y='10667'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#17324d' fontsize='16'>Business Priorities &amp; Action Plan</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#5d6b78' fontsize='10'>Evidence strength determines the action: test where the signal is strong, change measurement where the evidence is clear, and instrument before major checkout investment.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#c7d9ea' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='20' />
              <format attr='margin' value='10' />
              <format attr='padding' value='5' />
              <format attr='background-color' value='#ffffff' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='52000' id='499' type-v2='text' w='26500' x='16000' y='23500'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#234a8e' fontsize='12'>TEST PROFIT-AWARE MERCHANDISING</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>EVIDENCE</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Electronics receives </run>
              <run bold='true' fontcolor='#5d6b78'>~10.2%</run>
              <run fontcolor='#5d6b78'> of attention and contributes </run>
              <run bold='true' fontcolor='#5d6b78'>~15.3%</run>
              <run fontcolor='#5d6b78'> of profit; Books receives </run>
              <run bold='true' fontcolor='#5d6b78'>~17.5%</run>
              <run fontcolor='#5d6b78'> of attention but contributes </run>
              <run bold='true' fontcolor='#5d6b78'>~7.9%</run>
              <run fontcolor='#5d6b78'> of profit. Profit per view is about </run>
              <run bold='true' fontcolor='#5d6b78'>$6.90</run>
              <run fontcolor='#5d6b78'> vs </run>
              <run bold='true' fontcolor='#5d6b78'>$2.06</run>
              <run fontcolor='#5d6b78'> (~3.3×).</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>DECISION</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Run a controlled merchandising or promotion pilot that incorporates profitability alongside conversion.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>OWNER &amp; TIMING</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Merchandising / Growth + Analyst</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>4–6 weeks</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>SUCCESS MEASURES</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Profit per 1,000 views, Total Profit, Margin and CVR; guardrail: Total Sales.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#7b8794' fontsize='8' italic='true'>Key uncertainty: incremental profit from reallocating exposure is not yet observed.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#234a8e' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='2' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='20' />
              <format attr='margin' value='6' />
              <format attr='padding' value='2' />
              <format attr='background-color' value='#ffffff' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='52000' id='500' type-v2='text' w='26500' x='44500' y='23500'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#9a6500' fontsize='12'>BUILD CHECKOUT EVIDENCE BEFORE REDESIGN</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>EVIDENCE</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Cart → Checkout is the lowest observed progression (</run>
              <run bold='true' fontcolor='#5d6b78'>~55.1%</run>
              <run fontcolor='#5d6b78'>). Of </run>
              <run bold='true' fontcolor='#5d6b78'>81,518</run>
              <run fontcolor='#5d6b78'> cart sessions, </run>
              <run bold='true' fontcolor='#5d6b78'>44,909</run>
              <run fontcolor='#5d6b78'> reached checkout and </run>
              <run bold='true' fontcolor='#5d6b78'>36,609</run>
              <run fontcolor='#5d6b78'> did not. These are observed sessions, not proven lost orders.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>DECISION</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Do not prioritize a broad redesign yet. Instrument errors, shipping-cost reveal, payment failures, latency and abandonment first.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>OWNER &amp; TIMING</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Product Analytics + Product / Engineering</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>2–4 weeks</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>SUCCESS MEASURES</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Cart-to-Checkout, checkout error rate, payment failure rate and completion rate.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#7b8794' fontsize='8' italic='true'>Key uncertainty: cart abandonment cannot yet be attributed to checkout friction.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#d59a20' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='2' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='20' />
              <format attr='margin' value='6' />
              <format attr='padding' value='2' />
              <format attr='background-color' value='#fffaf0' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='52000' id='501' type-v2='text' w='26500' x='73000' y='23500'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#234a8e' fontsize='12'>STANDARDIZE RETENTION REPORTING</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>EVIDENCE</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Among purchasing customers, lifetime repeat rate is</run>
              <run bold='true' fontcolor='#5d6b78'> 61.7%</run>
              <run fontcolor='#5d6b78'>, while 90-day repeat is </run>
              <run bold='true' fontcolor='#5d6b78'>6.7%</run>
              <run fontcolor='#5d6b78'>. Newer cohorts have shorter observation windows, so lifetime comparisons are not like-for-like.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>DECISION</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Make eligibility-aware 30/60/90-day repeat the standard. Keep lifetime repeat as descriptive context only.</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>OWNER &amp; TIMING</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>Analytics Engineering / BI</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>1–2 weeks</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#17324d' fontsize='10'>SUCCESS MEASURES</run>
              <run>Æ&#10;</run>
              <run fontcolor='#5d6b78'>30/60/90-day repeat rates with the eligible-customer denominator shown.</run>
              <run>Æ&#10;</run>
              <run fontcolor='#7b8794' fontsize='8' italic='true'>Key limitation: absolute repeat timing reflects synthetic source behavior.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#234a8e' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='2' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='20' />
              <format attr='margin' value='6' />
              <format attr='padding' value='2' />
              <format attr='background-color' value='#ffffff' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='16556' id='502' type-v2='text' w='83500' x='16000' y='80444'>
            <formatted-text>
              <run bold='true' fontcolor='#17324d' fontsize='11'>IMPLEMENTATION ORDER</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#234a8e'>NOW</run>
              <run fontcolor='#5d6b78'> — standardize retention reporting   ·   </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#234a8e'>NEXT</run>
              <run fontcolor='#5d6b78'> — launch the controlled profit-aware pilot   ·   </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#9a6500'>BEFORE CHECKOUT INVESTMENT</run>
              <run fontcolor='#5d6b78'> — instrument and establish benchmarks</run>
              <run fontalignment='2'>Æ&#10;</run>
              <run fontalignment='2' fontcolor='#7b8794' fontsize='8'>Data coverage: 2020–2025; 2025 through 31 Oct.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#c7d9ea' />
              <format attr='border-style' value='solid' />
              <format attr='border-width' value='1' />
              <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='20' />
              <format attr='margin' value='10' />
              <format attr='padding' value='5' />
              <format attr='background-color' value='#eef4fa' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='0' />
            <format attr='background-color' value='#eaf2fb' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='8000' id='503' type-v2='text' w='28542' x='70694' y='1111'>
          <formatted-text>
            <run bold='true' fontcolor='#17324d' fontsize='10'>EVIDENCE BASE</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#17324d' fontsize='15'>2020–2025 </run>
            <run fontcolor='#17324d' fontsize='15'>|</run>
            <run bold='true' fontcolor='#17324d' fontsize='15'>Æ </run>
            <run bold='true' fontcolor='#17324d' fontsize='10'>Through 31 Oct 2025</run>
          </formatted-text>
