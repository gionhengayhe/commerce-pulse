    <worksheet name='How Sales Turn Into Profit'>
      <table>
        <view>
          <datasources>
            <datasource caption='DS Executive' name='federated.147a30b02ufoi11c837s20kpil3j' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p_Analysis Year' datatype='integer' datatype-customized='true' default-format='n0;-0' name='[Parameter 0808176514207744]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.147a30b02ufoi11c837s20kpil3j'>
            <column caption='Filter - Analysis Year' datatype='boolean' name='[Calculation_0808176528752644]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] AND [date_day] &lt;= [Calculation_202608200001]' />
            </column>
            <column caption='Discounts' datatype='real' name='[Calculation_1074259014565897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='- [discount_amount_usd]' />
            </column>
            <column caption='Product Cost' datatype='real' name='[Calculation_1074259014721546]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-[estimated_cogs_usd]' />
            </column>
            <column caption='Latest Active Date - Selected Year' datatype='date' name='[Calculation_202608200001]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED : MAX(IF YEAR([date_day]) = [Parameters].[Parameter 0808176514207744] AND ([orders] &gt; 0 OR [net_sales_usd] &lt;&gt; 0) THEN [date_day] END) }' />
            </column>
            <column caption='Date Day' datatype='date' name='[date_day]' role='dimension' type='ordinal' />
            <column caption='Discount Amount Usd' datatype='real' name='[discount_amount_usd]' role='measure' type='quantitative' />
            <column caption='Estimated Cogs Usd' datatype='real' name='[estimated_cogs_usd]' role='measure' type='quantitative' />
            <column caption='Estimated Gross Profit Usd' datatype='real' name='[estimated_gross_profit_usd]' role='measure' type='quantitative' />
            <column caption='Gross Sales Usd' datatype='real' name='[gross_sales_usd]' role='measure' type='quantitative' />
            <column caption='Net Sales Usd' datatype='real' name='[net_sales_usd]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0808176528752644]' derivation='None' name='[none:Calculation_0808176528752644:nk]' pivot='key' type='nominal' />
            <column caption='Orders' datatype='integer' hidden='true' name='[orders]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1074259014565897]' derivation='Sum' name='[sum:Calculation_1074259014565897:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1074259014721546]' derivation='Sum' name='[sum:Calculation_1074259014721546:qk]' pivot='key' type='quantitative' />
            <column-instance column='[estimated_gross_profit_usd]' derivation='Sum' name='[sum:estimated_gross_profit_usd:qk]' pivot='key' type='quantitative' />
            <column-instance column='[gross_sales_usd]' derivation='Sum' name='[sum:gross_sales_usd:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
