              <calculation class='tableau' formula='2025' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0ncwajr1cstery1fny6b605ttnuq'>
            <column caption='Month' datatype='datetime' name='[Calculation_0318071374913536]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [date_day])' />
            </column>
            <column caption='Monthly Cart Sessions' datatype='integer' name='[Calculation_0318071375499265]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_0318071374913536] :&#13;&#10;    SUM([cart_sessions])&#13;&#10;}' />
            </column>
            <column caption='Filter - Analysis Year' datatype='boolean' name='[Calculation_220001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([date_day]) = [Parameters].[Parameter 0808176514207744]' />
            </column>
            <column caption='Cart-to-Checkout Rate' datatype='real' default-format='p0.0%' name='[Calculation_221501]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([cart_sessions]) = 0 THEN NULL ELSE SUM([checkout_sessions]) / SUM([cart_sessions]) END' />
            </column>
            <column caption='Lowest Monthly Cart-to-Checkout Rate' datatype='real' default-format='p0.0%' name='[Calculation_242002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MIN([Calculation_221501])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Highest Monthly Cart-to-Checkout Rate' datatype='real' default-format='p0.0%' name='[Calculation_242003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MAX([Calculation_221501])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Annual Cart-to-Checkout Rate' datatype='real' default-format='p0.0%' name='[Cart-to-Checkout Rate (copy)_0318071376384004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#13;&#10;    SUM([checkout_sessions])&#13;&#10;}&#13;&#10;/&#13;&#10;{ FIXED :&#13;&#10;    SUM([cart_sessions])&#13;&#10;}' />
            </column>
            <column caption='Monthly Checkout Sessions' datatype='integer' name='[Monthly Cart Sessions (copy)_0318071375572994]' role='measure' type='quantitative'>
