# Docker Compose defaults are suitable for local development. Override these
# values before sharing the environment or storing Airflow connections.
AIRFLOW_VERSION=3.3.1
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_API_JWT_SECRET=change-this-local-jwt-secret
AIRFLOW_FERNET_KEY=
